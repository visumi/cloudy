{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudy-api",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGIN": "https://cloudy.isumi.com.br"
  },
  "secrets": {
    "required": ["TURSO_URL", "TURSO_AUTH_TOKEN", "FIREBASE_PROJECT_ID", "OWNER_EMAIL"]
  },
  "routes": [
    { "pattern": "cloudy-api.isumi.com.br", "custom_domain": true }
  ]
}
